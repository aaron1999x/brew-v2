# Supabase project URL (Settings -> Data API). Staging for dev/preview, production on Vercel Production.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...), safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server only, never exposed to the browser.
SUPABASE_SECRET_KEY=
# Public base URL of this deployment, e.g. http://localhost:3000 (used for links and metadata).
NEXT_PUBLIC_SITE_URL=
# One of: local | staging | production.
NEXT_PUBLIC_APP_ENV=
# Sentry DSN for client/server/edge error reporting (optional locally).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry auth token; when set, source maps are uploaded during build (CI/Vercel only).
SENTRY_AUTH_TOKEN=
# Sentry organisation slug; needed with SENTRY_AUTH_TOKEN to upload source maps (build only).
SENTRY_ORG=
# Sentry project slug; needed with SENTRY_AUTH_TOKEN to upload source maps (build only).
SENTRY_PROJECT=
# local only: Supabase CLI login for link/push/gen types against staging; never set in Vercel.
SUPABASE_ACCESS_TOKEN=
# Staging project ref (the ID in the staging dashboard URL); the only database scripts may touch.
STAGING_PROJECT_REF=
# Staging Postgres connection string (session pooler) with the password filled in.
STAGING_DB_URL=
# Production project ref, present ONLY so scripts/assert-staging.mjs can block it.
PRODUCTION_PROJECT_REF=
